# =============================================================================
# SRIP Portal Backend — Environment Configuration
# =============================================================================
# SETUP INSTRUCTIONS:
#   1. Copy this file:        cp .env.example .env
#   2. Fill in YOUR values below (especially the Email section)
#   3. NEVER commit your .env file to Git!
# =============================================================================

# Django settings
SECRET_KEY=django-insecure-change-this-to-a-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# EMAIL CONFIGURATION (Required for sending welcome emails to applicants)
# =============================================================================
# To send real emails, you need SMTP credentials.
#
# --- Gmail Setup (recommended for local dev) ---
#   1. Go to https://myaccount.google.com/security
#   2. Enable "2-Step Verification" if not already enabled
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Create an App Password (name it "SRIP Portal")
#   5. Copy the 16-character password Google gives you
#   6. Fill in EMAIL_HOST_USER and EMAIL_HOST_PASSWORD below
#
# --- Outlook / Institutional SMTP ---
#   Change EMAIL_HOST to your SMTP server (e.g. smtp.office365.com)
#   and update the port/credentials accordingly.
#
# If you leave EMAIL_BACKEND commented out, emails will print
# to the terminal instead of being sent (useful for testing).
# =============================================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=YOUR_EMAIL@gmail.com
EMAIL_HOST_PASSWORD=YOUR_16_CHAR_APP_PASSWORD
DEFAULT_FROM_EMAIL=YOUR_EMAIL@gmail.com

# To test WITHOUT sending real emails (prints to terminal instead),
# comment out the lines above and uncomment this:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# =============================================================================
# Anumati Integration
# =============================================================================
ANUMATI_BASE_URL=https://anumati1.iiitb.ac.in/api
ANUMATI_WEB_URL=https://anumati1.iiitb.ac.in
